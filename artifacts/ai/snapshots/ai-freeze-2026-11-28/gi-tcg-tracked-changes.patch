+    [StateSymbol]: "entity",
+    id: iterators.id--,
+    definition,
+    variables: Object.fromEntries(
+      Object.entries(definition.varConfigs).map(
+        ([name, { initialValue }]) => [name, initialValue],
+      ),
+    ) as Variables,
+    attachments: [],
+  };
